# Editor/tooling artifacts
skills-lock.json

# Local impeccable config and hook cache
.impeccable/

# Native Apple refactor (core/ + AnicatApple/)
core/target/
AnicatApple/.build/
# Produced by scripts/build-xcframework.sh from core/. ~200MB of static libs
# and a generated .swift — a build artifact, regenerated rather than reviewed.
AnicatApple/AnicatCore.xcframework/
AnicatApple/Sources/AnicatCoreKit/anicat_core.swift
AnicatApple/Frameworks/
AnicatApple/Sources/anicat_coreFFI/include/
# SwiftPM IDE state and the URLCache that lands in cwd when the binary is run
# outside a bundle (swift run / swift test) — never source.
AnicatApple/.swiftpm/
AnicatApple/anicat_image_cache/
# iOS Simulator compile check (`swift build --triple arm64-apple-ios17.0-simulator --scratch-path .build-ios`)
AnicatApple/.build-ios/
# tvOS Simulator compile check (`swift build --triple arm64-apple-tvos18.0-simulator --scratch-path .build-tvos`)
AnicatApple/.build-tvos/
# Generated by `xcodegen generate` from AnicatApple/project.yml — the iOS app
# target. The spec is the source of truth; the project and its Info.plist are
# regenerated, never reviewed.
AnicatApple/Anicat.xcodeproj/
AnicatApple/Generated/
# xcodebuild DerivedData for the iOS target
AnicatApple/.build-xcode/
# xcodebuild DerivedData for device builds
AnicatApple/.build-device/
# xcodebuild DerivedData for simulator app builds
AnicatApple/.build-sim/

# Windows server crate (server/), its own target like core/
server/target/
