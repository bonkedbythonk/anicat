{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anicat",
  "version": "4.0.0",
  "identifier": "com.bonkedbythonk.anicat",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Anicat",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:13370; img-src 'self' http://127.0.0.1:13370 https://s4.anilist.co data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' http://127.0.0.1:13370 https://s4.anilist.co https://graphql.anilist.co https://api.aniskip.com https://api.github.com; media-src 'self' blob: http://127.0.0.1:13370; frame-src 'self' https://www.youtube-nocookie.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/anicat-server"
    ],
    "resources": [
      "resources/**/*"
    ],
    "macOS": {
      "entitlements": "entitlements.mac.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "appimage": {},
      "deb": {
        "depends": ["mpv"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
