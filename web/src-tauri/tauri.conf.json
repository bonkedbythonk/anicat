{
  "productName": "Anicat",
  "version": "5.4.3",
  "identifier": "com.anicat.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Anicat",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "backgroundColor": "#00000000",
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "additionalBrowserArgs": "--disable-features=InputModeDefault",
        "windowEffects": {
          "effects": [
            "sidebar",
            "mica"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://graphql.anilist.co https://s4.anilist.co https://aniskip.com http://127.0.0.1:13370 http://127.0.0.1:* https://*; img-src 'self' asset: http://asset.localhost https://asset.localhost https://s4.anilist.co http://127.0.0.1:13370 http://127.0.0.1:* https://* data:; media-src 'self' asset: http://asset.localhost https://asset.localhost http://127.0.0.1:13370 https://* blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/mpv",
      "resources/mpv.exe",
      "resources/mpv_config/*",
      "resources/mpv_config/**/*",
      "resources/lib/*",
      "resources/lib/**/*",
      "resources/scraper-bin/anicat-scraper/anicat-scraper",
      "resources/scraper-bin/anicat-scraper/_internal/**/*",
      "mobile-dist/*",
      "mobile-dist/**/*"
    ]
  }
}
